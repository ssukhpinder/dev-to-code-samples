<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup Condition="$(DefineConstants.Contains('NET9_0_OR_GREATER'))">
    <ProjectReference Include="../MarkerLibrary/MarkerLibrary.csproj" />
  </ItemGroup>

  <Target Name="VerifyFrameworkReference">
    <Error
      Condition="'@(ProjectReference)' == ''"
      Code="DCG001"
      Text="The TFM-specific ProjectReference disappeared during MSBuild evaluation." />
  </Target>
</Project>
