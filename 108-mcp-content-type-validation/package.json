{
  "name": "mcp-content-type-validation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline MCP TypeScript SDK v2 Content-Type contract checks",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format:check": "prettier --check README.md package.json tsconfig.json src test",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.json",
    "verify": "npm run build --silent && node dist/src/content-type-contract.js",
    "test": "npm run build --silent && node --test dist/test/content-type-contract.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
